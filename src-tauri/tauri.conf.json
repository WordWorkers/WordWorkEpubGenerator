{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Word Work EPUB",
  "identifier": "se.schiren.wordwork.epub",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../frontend" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../frontend" },
    "devUrl": "http://localhost:5174",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Word Work EPUB",
        "width": 900,
        "height": 760,
        "minWidth": 520,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "© 2026 Mikke Schirén",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/ww-pandoc"],
    "shortDescription": "Gör e-böcker av Word Work-texter",
    "longDescription": "Sätter ihop Markdown-texter från Word Work till en EPUB-bok.",
    "publisher": "Mikke Schirén",
    "license": "Apache-2.0",
    "macOS": { "minimumSystemVersion": "11.0", "hardenedRuntime": true, "signingIdentity": "-" },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Swedish", "English"] },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
